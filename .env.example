# Copiar a .env y completar con los valores reales del proyecto de Supabase.

# Conexion pooled, modo transaccion (Supavisor, puerto 6543) — la usa la app en runtime (src/lib/prisma.ts).
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexion pooled, modo sesion (puerto 5432) — la usa `prisma migrate` (prisma7.config.ts).
# Nota: en proyectos nuevos de Supabase esta tambien pasa por el pooler (no por db.<ref>.supabase.co directo).
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# URL publica del sitio, usada para metadata/OG (src/lib/seo.ts).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
