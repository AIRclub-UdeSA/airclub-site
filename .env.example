# Copiar a .env y completar con los valores reales del proyecto de Supabase.

# Conexion pooled, modo transaccion (Supavisor, puerto 6543) — la usa la app en runtime (src/lib/prisma.ts).
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexion pooled, modo sesion (puerto 5432) — la usa `prisma migrate` (prisma7.config.ts).
# Nota: en proyectos nuevos de Supabase esta tambien pasa por el pooler (no por db.<ref>.supabase.co directo).
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# URL publica del sitio, usada para metadata/OG (src/lib/seo.ts).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Login de /admin (NextAuth + Google), ver src/auth.ts.
# Generar con: npx auth secret (o `openssl rand -base64 33`).
AUTH_SECRET="reemplazar-con-un-valor-random-largo"
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (tipo "Web application").
# Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID="xxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="xxxx"

# Supabase Storage (subida de fotos/videos de /admin/talks), ver src/lib/admin/storage.ts.
# Project Settings -> API. SUPABASE_SERVICE_ROLE_KEY es secreta (nunca al cliente): bypassa RLS,
# se usa solo dentro de server actions ya gateadas por requireSectionAccess.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="xxxx"
