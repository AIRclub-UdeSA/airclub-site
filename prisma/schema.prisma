generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URLs are no longer set here in Prisma 7 — see prisma7.config.ts (CLI/migrate,
  // uses DIRECT_URL) and src/lib/prisma.ts (runtime client, uses DATABASE_URL via a driver adapter).
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum RobotSpecGroup {
  HARDWARE
  SOFTWARE
}

enum AdminRole {
  ADMIN // acceso total, incluida la gestion de personas autorizadas
  EDITOR // acceso solo a las secciones listadas en AdminUser.sections
}

// Personas con acceso a /admin. Loguearse con Google restringido a @udesa.edu.ar no alcanza
// por si solo: hace falta ademas estar cargado aca. Ver src/lib/admin/permissions.ts.
model AdminUser {
  id        String     @id @default(cuid())
  email     String     @unique
  role      AdminRole
  sections  String[] // ids de seccion (ej: "talks"); ADMIN ignora este campo, ve todo
  // Sacar el acceso desactiva, no borra: AuditLog apunta a esta fila (onDelete: Restrict) y
  // el historial tiene que seguir diciendo quien hizo cada cambio.
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  auditLogs AuditLog[]
}

// Registro de cada accion de escritura hecha desde /admin. Se escribe en la misma
// transaccion que el cambio que audita (ver Etapa 3 de PLAN-ADMIN.md).
model AuditLog {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  section     String // ej: "talks"
  entityId    String // id del registro afectado
  action      String // ej: "create" | "update" | "delete" | "publish"
  before      Json?
  after       Json?
  createdAt   DateTime  @default(now())

  @@index([section, entityId])
  @@index([adminUserId])
}

enum TalkMediaType {
  IMAGE
  VIDEO
}

model Event {
  id                   String              @id @default(cuid())
  slug                 String              @unique
  title                String
  tagline              String?
  description          String              @db.Text
  location             String?
  startsAt             DateTime
  endsAt               DateTime?
  status               EventStatus         @default(PUBLISHED)
  externalUrl          String? // e.g. JAR site link, or a Google Form until RSVP ships
  rsvpEnabled          Boolean             @default(false) // stays false until the RSVP feature (deferred) ships
  capacity             Int?
  featuredForCountdown Boolean             @default(false)
  imageUrl             String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  registrations        EventRegistration[]

  @@index([startsAt])
}

// Schema is ready for RSVP now (deferred feature — no form/UI ships yet, see AGENTS/plan notes).
model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  email     String
  createdAt DateTime @default(now())

  @@unique([eventId, email]) // one RSVP per person per event; also the future account-linking key
  @@index([eventId])
}

model Robot {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  status      String // free text badge, e.g. "En desarrollo activo"
  category    String?
  tags        String[]
  description String      @db.Text
  imageUrl    String
  imageAlt    String
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  specs       RobotSpec[]
  links       RobotLink[]
}

model RobotSpec {
  id      String         @id @default(cuid())
  robotId String
  robot   Robot          @relation(fields: [robotId], references: [id], onDelete: Cascade)
  group   RobotSpecGroup // HARDWARE | SOFTWARE
  label   String
  value   String
  order   Int            @default(0)

  @@index([robotId])
}

model RobotLink {
  id      String @id @default(cuid())
  robotId String
  robot   Robot  @relation(fields: [robotId], references: [id], onDelete: Cascade)
  label   String
  url     String
  order   Int    @default(0)

  @@index([robotId])
}

enum TalkStatus {
  DRAFT
  PUBLISHED
}

model Talk {
  id                 String      @id @default(cuid())
  slug               String      @unique
  title              String
  subtitle           String
  abstract           String      @db.Text
  speakerName        String?
  speakerRole        String?
  speakerAffiliation String?
  speakerAvatar      String?
  speakerLinkedin    String?
  startsAt           DateTime?
  endsAt             DateTime?
  dateLabel          String? // reemplaza a la fecha exacta cuando aun no hay dia confirmado
  location           String?
  topic              String?
  recordingUrl       String? // grabacion completa de la charla, opcional: siempre link externo (YouTube), nunca Storage
  ctaLabel           String?
  ctaUrl             String?
  status             TalkStatus  @default(PUBLISHED) // borrador no aparece en /talks
  confirmed          Boolean     @default(false) // false = todavia "a confirmar" (titulo/orador/resumen placeholder)
  order              Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  media              TalkMedia[]
  slides             TalkSlide[]
  links              TalkLink[]
}

model TalkMedia {
  id     String        @id @default(cuid())
  talkId String
  talk   Talk          @relation(fields: [talkId], references: [id], onDelete: Cascade)
  type   TalkMediaType
  src    String
  poster String? // solo para videos
  order  Int           @default(0)

  @@index([talkId])
}

model TalkSlide {
  id       String @id @default(cuid())
  talkId   String
  talk     Talk   @relation(fields: [talkId], references: [id], onDelete: Cascade)
  title    String
  embedUrl String
  openUrl  String
  order    Int    @default(0)

  @@index([talkId])
}

model TalkLink {
  id     String @id @default(cuid())
  talkId String
  talk   Talk   @relation(fields: [talkId], references: [id], onDelete: Cascade)
  label  String
  url    String
  order  Int    @default(0)

  @@index([talkId])
}

model TeamMember {
  id            String   @id @default(cuid())
  name          String
  role          String? // nullable: current roster has no roles yet. CAUTION: getFounders()/getCollaborators()
  // in src/lib/team.ts currently filter on this exact string ("Fundador"/"Colaborador") to
  // group people — setting a real per-person role here will silently drop that person from
  // both lists until team.ts gets a dedicated group field.
  photoUrl      String? // nullable: currently one group photo, not per-person
  bio           String?  @db.Text
  linkedin      String? // perfil publico de LinkedIn
  linkedinPhoto String? // foto de LinkedIn: no se puede traer automaticamente, se sube a mano (URL o ruta)
  github        String? // perfil publico de GitHub
  order         Int      @default(0)
  active        Boolean  @default(true) // soft-remove without losing history
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
