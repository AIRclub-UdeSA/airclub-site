generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URLs are no longer set here in Prisma 7 — see prisma7.config.ts (CLI/migrate,
  // uses DIRECT_URL) and src/lib/prisma.ts (runtime client, uses DATABASE_URL via a driver adapter).
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum RobotSpecGroup {
  HARDWARE
  SOFTWARE
}

enum AdminRole {
  ADMIN // acceso total, incluida la gestion de personas autorizadas
  EDITOR // acceso solo a las secciones listadas en AdminUser.sections
}

// Personas con acceso a /admin. Cualquier cuenta de Google puede loguearse al sitio, pero el panel
// pide ademas un mail @udesa.edu.ar y estar cargado aca y activo (ver adminAccessFor en
// src/lib/auth-access.ts y src/lib/admin/permissions.ts).
model AdminUser {
  id        String     @id @default(cuid())
  email     String     @unique
  role      AdminRole
  sections  String[] // ids de seccion (ej: "talks"); ADMIN ignora este campo, ve todo
  // Sacar el acceso desactiva, no borra: AuditLog apunta a esta fila (onDelete: Restrict) y
  // el historial tiene que seguir diciendo quien hizo cada cambio.
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  auditLogs AuditLog[]
}

// Registro de cada accion de escritura hecha desde /admin. Se escribe en la misma
// transaccion que el cambio que audita (ver Etapa 3 de PLAN-ADMIN.md).
model AuditLog {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  section     String // ej: "talks"
  entityId    String // id del registro afectado
  action      String // ej: "create" | "update" | "delete" | "publish"
  before      Json?
  after       Json?
  createdAt   DateTime  @default(now())

  @@index([section, entityId])
  @@index([adminUserId])
}

enum ProfileRole {
  STUDENT
  PROFESSOR
  OTHER
}

enum StudentStatus {
  STUDYING
  GRADUATED
}

// Perfil publico de cualquier cuenta de Google (no es AdminUser: una persona puede tener las dos
// filas, por el mismo email, sin relacion entre ellas). Se completa una sola vez al loguearse por
// primera vez (ver requireUserProfile en src/lib/perfil/require-profile.ts) y despues sirve para
// autocompletar la inscripcion a charlas (ver #50). Ser miembro de la comunidad es tener el perfil
// completo (ver isProfileComplete en src/lib/perfil/completeness.ts).
model UserProfile {
  id                String              @id @default(cuid())
  email             String              @unique
  role              ProfileRole
  otherRole         String? // detalle libre, solo si role = OTHER
  careers           String[] // slugs de src/lib/perfil/careers.ts, solo si role = STUDENT
  otherCareer       String? // detalle libre, solo si careers incluye el slug "otra"
  startYear         Int? // ano de inicio de la carrera, solo si role = STUDENT
  studentStatus     StudentStatus? // solo si role = STUDENT
  fullName          String? // nombre y apellido; NULL en cuentas anteriores a #P2
  affiliation       ProfileAffiliation? // de donde es la persona; NULL en cuentas anteriores
  institution       String? // nombre de la institucion, solo si affiliation != UDESA
  consentAcceptedAt DateTime? // cuando aceptó el aviso de /privacidad
  communityJoinedAt DateTime? // la primera vez que el perfil quedó completo (saveProfileAction); NULL en cuentas que no lo completaron
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

enum ProfileAffiliation {
  UDESA
  OTHER_UNIVERSITY
  WORK
  INDEPENDENT
}

enum TalkMediaType {
  IMAGE
  VIDEO
}

model Event {
  id                   String              @id @default(cuid())
  slug                 String              @unique
  title                String
  tagline              String?
  description          String              @db.Text
  location             String?
  startsAt             DateTime
  endsAt               DateTime?
  status               EventStatus         @default(PUBLISHED)
  externalUrl          String? // e.g. JAR site link, or a Google Form until RSVP ships
  rsvpEnabled          Boolean             @default(false) // stays false until the RSVP feature (deferred) ships
  capacity             Int?
  featuredForCountdown Boolean             @default(false)
  imageUrl             String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  registrations        EventRegistration[]

  @@index([startsAt])
}

// Schema is ready for RSVP now (deferred feature — no form/UI ships yet, see AGENTS/plan notes).
model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  email     String
  createdAt DateTime @default(now())

  @@unique([eventId, email]) // one RSVP per person per event; also the future account-linking key
  @@index([eventId])
}

model Robot {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  status      String // free text badge, e.g. "En desarrollo activo"
  category    String?
  tags        String[]
  description String      @db.Text
  imageUrl    String
  imageAlt    String
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  specs       RobotSpec[]
  links       RobotLink[]
}

model RobotSpec {
  id      String         @id @default(cuid())
  robotId String
  robot   Robot          @relation(fields: [robotId], references: [id], onDelete: Cascade)
  group   RobotSpecGroup // HARDWARE | SOFTWARE
  label   String
  value   String
  order   Int            @default(0)

  @@index([robotId])
}

model RobotLink {
  id      String @id @default(cuid())
  robotId String
  robot   Robot  @relation(fields: [robotId], references: [id], onDelete: Cascade)
  label   String
  url     String
  order   Int    @default(0)

  @@index([robotId])
}

enum TalkStatus {
  DRAFT
  PUBLISHED
}

// Quién puede inscribirse a una charla o a un taller presencial: solo cuentas @udesa.edu.ar o cualquiera.
// Sin valor por defecto: al crear un evento se elige a propósito (los que ya existían quedaron en UDESA).
enum Audience {
  UDESA
  ALL
}

model Talk {
  id                 String             @id @default(cuid())
  slug               String             @unique
  title              String
  subtitle           String
  abstract           String             @db.Text
  speakerName        String?
  speakerRole        String?
  speakerAffiliation String?
  speakerAvatar      String?
  speakerLinkedin    String?
  speakerBio         String?            @db.Text
  startsAt           DateTime?
  endsAt             DateTime?
  dateLabel          String? // reemplaza a la fecha exacta cuando aun no hay dia confirmado
  location           String?
  topic              String?
  recordingUrl       String? // grabacion completa de la charla, opcional: siempre link externo (YouTube), nunca Storage
  ctaLabel           String?
  ctaUrl             String?
  registrationOpen   Boolean            @default(false) // true = inscripcion propia del sitio en vez de ctaUrl (ver #50); excluyentes
  capacity           Int? // cupo de la inscripcion propia; null = sin limite
  audience           Audience // quien puede inscribirse (ver src/lib/udesa.ts); se ve para todos
  status             TalkStatus         @default(PUBLISHED) // borrador no aparece en /talks
  confirmed          Boolean            @default(false) // false = todavia "a confirmar" (titulo/orador/resumen placeholder)
  order              Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  media              TalkMedia[]
  slides             TalkSlide[]
  links              TalkLink[]
  speakers           TalkSpeaker[]
  registrations      TalkRegistration[]
}

// Oradores de una charla, en orden. Reemplaza a las columnas speaker* de Talk, que quedan sin leerse y
// se retiran en un PR aparte. Por ahora el panel sigue copiando al primero ahí, por si hay que volver atrás.
model TalkSpeaker {
  id          String  @id @default(cuid())
  talkId      String
  talk        Talk    @relation(fields: [talkId], references: [id], onDelete: Cascade)
  name        String
  role        String
  affiliation String?
  avatar      String?
  linkedin    String?
  bio         String? @db.Text
  order       Int     @default(0)

  @@index([talkId])
}

// Inscripcion propia de una charla (talk.registrationOpen = true), gemelo de EventRegistration.
// No guarda nombre: se completa con el email de la sesion y el resto sale de UserProfile (#49).
model TalkRegistration {
  id        String   @id @default(cuid())
  talkId    String
  talk      Talk     @relation(fields: [talkId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@unique([talkId, email])
  @@index([talkId])
}

enum WorkshopLevel {
  INICIAL
  INTERMEDIO
  AVANZADO
}

// Un workshop (Linux, ROS 2 y robótica…): una caja en /workshops y su página /workshops/<key>, con
// sus talleres adentro. Se edita desde /admin/workshops; el orden de las cajas es `order`.
model WorkshopTrack {
  id        String            @id @default(cuid())
  key       String            @unique // va en la URL (/workshops/<key>): no cambiarlo una vez publicado
  title     String
  label     String? // nota mono en la caja ("Challenge JAR 2026")
  summary   String            @db.Text
  setupUrl  String? // guía de instalación que piden sus guías (el setup del simulador del JAR)
  repoUrl   String? // repositorio que se clona antes de la primera guía (jar_workshops)
  status    TalkStatus        @default(PUBLISHED) // borrador no aparece en /workshops
  order     Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  guides    WorkshopGuide[]
  sessions  WorkshopSession[]
}

// Guía asincrónica de un workshop (una semana del recorrido del JAR). Su contenido puede vivir en otro
// sitio (`guideUrl`, con el código en `codeUrl`), dentro de este (`content`: bloques cargados desde
// /admin/workshops, ver src/lib/guide-blocks.ts), o las dos cosas; al menos una. El `slug` es con lo que
// se guarda quién la hizo (WorkshopCompletion): no cambiarlo.
model WorkshopGuide {
  id          String        @id @default(cuid())
  trackId     String
  track       WorkshopTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  slug        String        @unique
  week        String // dos cifras ("01", "02"…): el numeral grande de la página
  title       String
  summary     String        @db.Text
  outcome     String        @db.Text // qué te llevás al terminar
  minutesMin  Int
  minutesMax  Int
  level       WorkshopLevel
  ros2Package String? // paquete que se compila esa semana; sin él no se muestran los comandos
  requires    String[] // semanas (`week`) del mismo workshop que hay que tener hechas antes
  guideUrl    String?
  codeUrl     String?
  content     Json? // bloques de la guía (texto, pasos, código, imagen, aviso, checkpoint), en orden
  status      TalkStatus    @default(PUBLISHED)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([trackId])
}

// Taller presencial, de punta a punta (#70): con fecha futura es un "próximo taller" con inscripción
// propia; cuando pasa, el mismo registro suma el material de una charla de /talks (fotos y videos,
// diapositivas, grabación y links). Los eventos de categoría "workshop" siguen funcionando aparte.
model WorkshopSession {
  id               String                 @id @default(cuid())
  trackId          String
  track            WorkshopTrack          @relation(fields: [trackId], references: [id], onDelete: Cascade)
  slug             String                 @unique // igual que en WorkshopGuide: no cambiarlo
  title            String
  summary          String                 @db.Text // corto: va en su tarjeta, adentro del workshop
  description      String?                @db.Text // lo que se vio, en la pestaña Resumen de su página; sin ella, va `summary`
  startsAt         DateTime?
  endsAt           DateTime?
  dateLabel        String?
  location         String?
  instructor       String?
  recordingUrl     String? // siempre link externo (YouTube), como en Talk
  registrationOpen Boolean                @default(false) // inscripción propia del sitio mientras no pasó
  capacity         Int? // cupo de la inscripción; null = sin límite
  audience         Audience // quién puede inscribirse (ver src/lib/udesa.ts); se ve para todos
  status           TalkStatus             @default(PUBLISHED)
  order            Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  media            WorkshopSessionMedia[]
  slides           WorkshopSessionSlide[]
  links            WorkshopSessionLink[]
  registrations    WorkshopRegistration[]

  @@index([trackId])
}

// Inscripción a un taller presencial (#70), gemela de TalkRegistration. Cuando el taller termina,
// quien estaba inscripto lo tiene hecho sin tocar nada (se calcula al leer, ver
// src/lib/workshop-completions.ts). Si no fue, lo desmarca y queda `markedAbsent`.
model WorkshopRegistration {
  id           String          @id @default(cuid())
  sessionId    String
  session      WorkshopSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  email        String
  markedAbsent Boolean         @default(false)
  createdAt    DateTime        @default(now())

  @@unique([sessionId, email])
  @@index([email])
}

model WorkshopSessionMedia {
  id        String          @id @default(cuid())
  sessionId String
  session   WorkshopSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      TalkMediaType
  src       String
  poster    String? // solo para videos
  lightBg   Boolean         @default(false)
  objectFit String? // "contain" | "cover"
  order     Int             @default(0)

  @@index([sessionId])
}

model WorkshopSessionSlide {
  id        String          @id @default(cuid())
  sessionId String
  session   WorkshopSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title     String
  embedUrl  String
  openUrl   String
  order     Int             @default(0)

  @@index([sessionId])
}

model WorkshopSessionLink {
  id        String          @id @default(cuid())
  sessionId String
  session   WorkshopSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  label     String
  url       String
  order     Int             @default(0)

  @@index([sessionId])
}

// Workshop que una cuenta marcó como hecho (#2): arma su recorrido en /workshops y su pestaña
// Aprendizaje en /perfil. Se guarda el slug del taller (WorkshopGuide, WorkshopSession o un evento de
// categoría "workshop"), sin clave foránea, porque puede venir de cualquiera de los tres. Como en
// TalkRegistration, se identifica por el email de la sesión y los datos de la persona salen de UserProfile.
model WorkshopCompletion {
  id           String   @id @default(cuid())
  email        String
  workshopSlug String
  completedAt  DateTime @default(now())

  @@unique([email, workshopSlug])
  @@index([email])
}

model TalkMedia {
  id        String        @id @default(cuid())
  talkId    String
  talk      Talk          @relation(fields: [talkId], references: [id], onDelete: Cascade)
  type      TalkMediaType
  src       String
  poster    String? // solo para videos
  lightBg   Boolean       @default(false)
  objectFit String? // "contain" | "cover"
  order     Int           @default(0)

  @@index([talkId])
}

model TalkSlide {
  id       String @id @default(cuid())
  talkId   String
  talk     Talk   @relation(fields: [talkId], references: [id], onDelete: Cascade)
  title    String
  embedUrl String
  openUrl  String
  order    Int    @default(0)

  @@index([talkId])
}

model TalkLink {
  id     String @id @default(cuid())
  talkId String
  talk   Talk   @relation(fields: [talkId], references: [id], onDelete: Cascade)
  label  String
  url    String
  order  Int    @default(0)

  @@index([talkId])
}

enum TeamGroup {
  FOUNDER // se lista en "Fundadores" en /equipo
  COLLABORATOR // se lista en "Colaboradores"
}

// Foto grupal de una lista de /equipo y el texto del cartel sobre ella (hoy solo Fundadores muestra una).
// Sin fila, /equipo usa la foto y el texto fijos del código (/equipo.jpg, "Los fundadores del AIR Club").
model TeamGroupPhoto {
  group     TeamGroup @id
  photoUrl  String
  caption   String
  updatedAt DateTime  @updatedAt
}

model TeamMember {
  id            String    @id @default(cuid())
  // Identificador estable (ej. "juan-kaplan"): el seed actualiza por slug en vez de borrar y
  // recrear, así el id no cambia y otras tablas pueden apuntar a una persona sin romperse.
  slug          String    @unique
  name          String
  group         TeamGroup // en qué lista de /equipo aparece; no confundir con role
  role          String? // cargo de la persona (ej. "Presidente"), opcional; no afecta en qué lista aparece
  photoUrl      String? // nullable: currently one group photo, not per-person
  bio           String?   @db.Text
  linkedin      String? // perfil publico de LinkedIn
  linkedinPhoto String? // foto de LinkedIn: no se puede traer automaticamente, se sube a mano (URL o ruta)
  github        String? // perfil publico de GitHub
  order         Int       @default(0)
  active        Boolean   @default(true) // soft-remove without losing history
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum FeedbackType {
  BUG
  CONTENIDO // contenido incorrecto
  IDEA
  OTRO
}

enum FeedbackStatus {
  NUEVO
  EN_CURSO
  RESUELTO
  DESCARTADO
}

// Feedback que deja cualquier persona desde el botón flotante del sitio (#120, v1). El formulario es abierto
// (no pide cuenta), así que el envío pasa por un campo trampa y un límite por ipHash (ver src/lib/feedback/).
// Lo técnico (página, pantalla, navegador, tema) va separado de lo personal (email, ipHash) para que en la v2
// se pueda pasar a un issue del repo público sin copiar datos personales.
model Feedback {
  id           String         @id @default(cuid())
  type         FeedbackType
  message      String // hasta FEEDBACK_MAX_LENGTH caracteres, validado en el servidor
  path         String // ruta interna donde se tocó el botón, sin query string ni hash
  viewport     String? // "ancho×alto" de la ventana, ej: "1280x800"
  userAgent    String?
  theme        String? // "light" | "dark"
  // Datos personales. La sesión es por email (no hay tabla de usuarios), así que la cuenta se guarda por email.
  accountEmail String? // email de la cuenta, si había sesión
  email        String? // email de contacto que dejó, solo si no había sesión (opcional)
  ipHash       String // HMAC de la IP con AUTH_SECRET; la IP en limpio nunca se guarda
  status       FeedbackStatus @default(NUEVO)
  digestedAt   DateTime? // cuándo salió en el mail diario al club (src/app/api/cron/feedback-digest); NULL = todavía no
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([ipHash, createdAt])
  @@index([status, createdAt])
}
